auto-install-peers=false
strict-peer-dependencies=false

# Windows : les chemins profonds de pnpm (vite + peer deps) dépassent souvent MAX_PATH (~260),
# ce qui tronque les résolutions en "\node_" et casse Vite / @tailwindcss/node.
# Hoisted = node_modules plus plat, proche de npm, chemins beaucoup plus courts.
node-linker=hoisted
